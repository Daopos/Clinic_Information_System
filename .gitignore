# =========================
# Global
# =========================
node_modules/
dist/
build/
.env
.env.*  # like .env.development, .env.local

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp

# =========================
# Frontend (in /frontend)
# =========================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.next/        # Next.js
frontend/.turbo/       # TurboRepo
frontend/.expo/        # React Native / Expo

# React cache
frontend/.cache/
frontend/.parcel-cache/

# =========================
# Backend (in /backend)
# =========================
backend/node_modules/
backend/dist/
backend/build/
backend/.env
backend/coverage/
backend/.cache/

# PM2 Logs or runtime files
backend/pids/
backend/logs/

# Prisma
backend/prisma/dev.db
backend/prisma/dev.db-journal

# =========================
# Testing
# =========================
coverage/
*.lcov
test-results/

# Vitest / Jest cache
.vitest/
jest.config.ts

# =========================
# Others (optional)
# =========================
*.tgz
*.tsbuildinfo
